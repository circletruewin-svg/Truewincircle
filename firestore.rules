rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Master role — sits between admin and regular users. Has finite
    // points and can only touch users assigned to them (via signup
    // referral link).
    function isMaster() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    // True when the resource being read/written has assignedMasterId
    // pointing at the calling master. Used by user / top-up /
    // withdrawal rules to scope masters to their own players.
    function ownsThisPlayer() {
      return isMaster() &&
        resource.data.get('assignedMasterId', '') == request.auth.uid;
    }

    // Rules for the results collection
    match /results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rules for the users collection
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.referredBy == request.auth.uid ||
        // Master can read their own players. Same query the master
        // panel uses (where assignedMasterId == my uid) is allowed.
        (isMaster() && resource.data.get('assignedMasterId', '') == request.auth.uid) ||
        // Anonymous-but-authenticated visitors need a 1-row lookup of
        // a master by code at signup time so the link can be honoured.
        // We only allow that exact shape: querying users with
        // role=='master' is OK. The actual rule engine doesn't see
        // queries directly so the per-doc read still applies — a
        // visitor reading a master doc only ever happens via the
        // signup lookup. To keep this safe we allow read of any user
        // whose role is 'master' (their masterCode is public-shareable
        // anyway since it's on their referral link).
        resource.data.get('role', '') == 'master'
      );
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'suspended', 'masterCode', 'assignedMasterId']) ||
          (request.resource.data.role == resource.data.role &&
           request.resource.data.get('suspended', false) == resource.data.get('suspended', false) &&
           request.resource.data.get('masterCode', '') == resource.data.get('masterCode', '') &&
           request.resource.data.get('assignedMasterId', '') == resource.data.get('assignedMasterId', ''))
        )) ||
        // Master adjusting their own player's wallet. We allow any
        // balance / winningMoney change here and rely on the client-
        // side transaction + masterLedger audit to keep things honest.
        // (Atomic getAfter() check turned out to be unreliable across
        // multi-doc tx commits.) Protected fields stay locked.
        (isMaster() &&
         resource.data.get('assignedMasterId', '') == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'assignedMasterId', 'masterCode', 'suspended']))
      );

      // Per-user notifications subcollection.
      // Owner can read and mark as read; admins and backend can write.
      match /notifications/{notifId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin();
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if isAdmin();
      }
    }

    // Referral commissions ledger. Fully admin-internal — users
    // can't read, write, or even know this collection exists. The
    // user-facing Referrals page deliberately doesn't surface
    // commission data, so users see no UI difference.
    match /commissions/{commissionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Master point ledger — every admin↔master and master↔player
    // balance adjustment lands here for audit. Admin writes anything;
    // masters can read + log their own player-side adjustments.
    match /masterLedger/{txId} {
      allow read: if isAdmin() ||
        (isMaster() && resource.data.masterId == request.auth.uid);
      // Master can only insert rows where masterId == self and the
      // type is one of the player-side operations. They can't fake
      // an admin top-up.
      allow create: if isAdmin() ||
        (isMaster() &&
         request.resource.data.masterId == request.auth.uid &&
         request.resource.data.type in ['master_to_player', 'player_to_master', 'deposit_approval', 'withdrawal_approval', 'withdrawal_reject']);
      allow update, delete: if isAdmin();
    }

    // Pre-staged user accounts. Admin creates a /pendingUsers/{phone}
    // doc from the admin panel (phone format: "+91XXXXXXXXXX"). When the
    // matching phone signs in for the first time, the SignIn / SignUp
    // pages copy the doc into users/{uid} and delete the pending entry.
    // Read + delete are allowed for the admin OR the user whose verified
    // phone token matches the doc id; create / update are admin-only.
    match /pendingUsers/{phoneId} {
      allow read, delete: if isAdmin() ||
        (request.auth != null && request.auth.token.phone_number == phoneId);
      allow create, update: if isAdmin();
    }

    // Aviator rounds — public state ONLY. Backend writes the live
    // round status here. The secret crash point lives in
    // aviator_secrets and is not readable by clients.
    match /aviator_rounds/{roundId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Aviator secret state (crashPoint). Backend reads this with the
    // Admin SDK (which bypasses rules); clients have NO access.
    match /aviator_secrets/{docId} {
      allow read, write: if false;
    }

    // ── Cricket / sports betting ─────────────────────────────
    // Matches: publicly readable (anyone can see upcoming matches
    // and past results); only admins can create / edit / settle.
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User bets on sports matches.
    //
    // Hardened to prevent the obvious money-mint attack: if create only
    // checked userId+status, a logged-in user could write a bet doc with
    // any oddsAtBet / betAmount, no funds debited, and once the admin
    // settled the match they'd be credited oddsAtBet * betAmount. The
    // rule below now insists that:
    //   - the match exists, is still upcoming and hasn't started;
    //   - oddsAtBet matches whatever odds the admin set on the match
    //     for the chosen betType + selection;
    //   - betAmount is a sane number within the per-bet cap;
    //   - the same write actually drops the user's balance+winningMoney
    //     by exactly betAmount (so funds are real).
    //
    // Updates (status/winAmount after settlement) stay admin-only.
    match /sportsBets/{betId} {
      function fundsDebitedByExactly(amount) {
        let userBefore = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let userAfter  = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let beforeTotal = (userBefore.balance is number ? userBefore.balance : 0)
                        + (userBefore.winningMoney is number ? userBefore.winningMoney : 0);
        let afterTotal  = (userAfter.balance is number ? userAfter.balance : 0)
                        + (userAfter.winningMoney is number ? userAfter.winningMoney : 0);
        return afterTotal == beforeTotal - amount;
      }

      function oddsLineUp(matchData) {
        let bt = request.resource.data.betType;
        let sel = request.resource.data.selection;
        let odds = request.resource.data.oddsAtBet;
        // For winner / toss, odds live at matchData.odds.<betType>.<selection>.
        return (
          (bt == "winner" && odds == matchData.odds.winner.get(sel, 0))
          || (bt == "toss"   && odds == matchData.odds.toss.get(sel, 0))
          // For total, selection is "over" or "under".
          || (bt == "total"  && odds == matchData.odds.total.get(sel, 0))
          // topBatsman is an array — verifying odds vs name in rules is
          // awkward, so cap odds at 50x and trust the array structure.
          || (bt == "topBatsman" && odds <= 50 && odds >= 1)
          // ── 99exch-style session / fancy markets ─────────────
          // Each match doc has an optional customMarkets map keyed by
          // marketId. The bet doc carries marketId + selection. We
          // look the market up and verify the bet's odds match what
          // the admin published, the market is still open, and the
          // selection is one of the four valid sides.
          || ((bt == "session" || bt == "fancy") && customMarketLineUp(matchData))
        );
      }

      function customMarketLineUp(matchData) {
        let mid = request.resource.data.marketId;
        let market = matchData.get("customMarkets", {}).get(mid, {});
        let sel = request.resource.data.selection;
        let odds = request.resource.data.oddsAtBet;
        return market.get("status", "") == "open" && (
          (market.get("type", "") == "overUnder" && (
            (sel == "over"  && odds == market.get("oddsOver", 0))
            || (sel == "under" && odds == market.get("oddsUnder", 0))
          ))
          || (market.get("type", "") == "yesNo" && (
            (sel == "yes" && odds == market.get("oddsYes", 0))
            || (sel == "no"  && odds == market.get("oddsNo",  0))
          ))
        );
      }

      // Built-in markets (winner / toss / total / topBatsman) close
      // when the match starts. Session / fancy markets stay open
      // through the match — their per-market `status` field gates them
      // (already enforced inside customMarketLineUp).
      function timingOk(matchData) {
        let bt = request.resource.data.betType;
        return matchData.status == "upcoming" && (
          (bt == "session" || bt == "fancy")
          || matchData.startTime > request.time
        );
      }

      // Admin can place bets on behalf of any user (e.g. offline
      // player flow) — they're already trusted, the heavy validation
      // below is only needed for self-served user writes.
      allow create: if request.auth != null && isAdmin();
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.betAmount is number
        && request.resource.data.betAmount >= 10
        && request.resource.data.betAmount <= 100000
        && request.resource.data.oddsAtBet is number
        && request.resource.data.oddsAtBet >= 1
        && request.resource.data.oddsAtBet <= 1000
        && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId))
        && timingOk(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data)
        && oddsLineUp(get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data)
        && fundsDebitedByExactly(request.resource.data.betAmount);

      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Rules for the main game state document (1-12 Win Game)
    match /game_state/{docId} {
      allow read, write: if request.auth != null;
    }

    // Rules for the bets placed in the 1-12 Win game
    match /wingame_bets/{betId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Rules for the historical record of game rounds (1-12 Win).
    // Any authenticated client can append a round's result here when
    // its browser is the one that resolves the result phase, so other
    // browsers (and late visitors) can settle their own bets against
    // the stored number.
    match /wingame_rounds/{roundId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // Rules for the withdrawals collection
    match /withdrawals/{withdrawalId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Owner + admin + the player's master can read. Master access
      // lets the master panel show their player's withdrawal history.
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isMaster() && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('assignedMasterId', '') == request.auth.uid)
      );
      // Admin always; master only for their player + only when the
      // doc was pending and the next status is approved/rejected.
      allow update: if isAdmin() ||
        (isMaster() &&
         resource.data.status == 'pending' &&
         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('assignedMasterId', '') == request.auth.uid &&
         request.resource.data.status in ['approved', 'rejected']);
    }

    // Rules for top-up (deposit) requests
    match /top-ups/{topUpId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isMaster() && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('assignedMasterId', '') == request.auth.uid)
      );
      allow update: if isAdmin() ||
        (isMaster() &&
         resource.data.status == 'pending' &&
         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('assignedMasterId', '') == request.auth.uid &&
         request.resource.data.status in ['approved', 'rejected']);
      allow delete: if isAdmin();
    }

    // Rules for the exchangeRequests collection
    match /exchangeRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Rules for the winners collection
    match /winners/{winnerId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if request.auth != null;
    }

    // Rules for the transactions collection (referral bonuses, etc.)
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
    }

    // Marquee settings
    match /settings/marquee {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Jackpot settings
    match /settings/jackpot {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Home layout toggles (showCountdown / showCarousel etc.). Public
    // read because every visitor's Home renders against it; admin-only
    // write.
    match /settings/layout {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User-facing notification sound configuration. Anyone (logged in
    // or not) needs to read it because the player is loaded on every
    // page. Only admin can change it.
    match /settings/userSoundConfig {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-number bet limits for Gali / Disawar / etc. (Haruf). Public
    // read so the betting UI can render the right validation messages
    // and disable inputs above the cap; admin-only write.
    match /settings/harufLimits {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bets (legacy)
    match /bets/{betId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Haruf bets (legacy)
    match /harufBets/{betId} {
      // Owner can place their own bets normally; admin can also place
      // bets on behalf of an offline player (Place Bet flow).
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow read: if request.auth != null;
      allow update: if isAdmin();
    }

    // Carousel slides
    match /carousel_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Market timings
    match /market_timings/{marketId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Roulette bets
    match /rouletteBets/{betId} {
      allow create, update: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Payment methods (UPI, USDT config)
    match /paymentMethods/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Deposit requests
    match /depositRequests/{depositId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    // Market data (USDT rates)
    match /marketData/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Social links
    match /social_links/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── NEW: Casino games collections ──────────────────────────────────

    // Aviator
    match /aviatorBets/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }
    match /aviatorHistory/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Color Prediction
    match /colorBets/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }
    match /colorHistory/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Coin Flip
    match /coinFlipHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Dice Roll
    match /diceBets/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Teen Patti
    match /teenPattiHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Dragon Tiger
    match /dtHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Andar Bahar
    match /abHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // ── 99exch-style additions ─────────────────────────────────────────
    // All 7 follow the same shape as the older casino history collections:
    // owner-only create with userId match, broad read for the leaderboard
    // / "live winners" feeds the Home page renders.

    match /lucky7History/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }
    match /hiLoHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }
    match /minesHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }
    match /rouletteHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }
    match /baccaratHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }
    match /plinkoHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }
    match /cards32History/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // ── END: Casino games collections ──────────────────────────────────

  }
}
