rules_version = '2';

// Firebase Storage rules — kept permissive to match the pre-existing
// project posture so admin barcode upload, user payment-screenshot
// upload, and master QR upload all work without per-path scoping.
//
// Security note: per-path tightening (e.g. only the owner can write
// under their own UID folder) is a follow-up — but it has to be done
// carefully because more than one path is in active use. For now we
// trust the front-end to write to the right paths and rely on
// Firestore rules for the authoritative authorization checks.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Public read — payment QRs need to render without an auth
      // round-trip for browser image caching. Storage URLs are
      // signed download URLs anyway, so leaking the URL leaks the
      // image but nothing else.
      allow read: if true;
      // Any signed-in user can upload. The admin / master / user
      // panels each write to their own well-known prefixes.
      allow write: if request.auth != null;
    }
  }
}
